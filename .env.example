# Supabase — Canine Companion
#
# Copy this file to .env.local and fill in the anon key from
# Supabase → Project Settings → API → Project API keys → "anon" / "public".
# The anon (publishable) key is safe to expose in the browser; row-level
# security is what protects the data.
NEXT_PUBLIC_SUPABASE_URL=https://jebgptovxxtehniybjka.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Service-role key — required ONLY by the /admin interface, which reads and
# writes the newsletter_subscribers and breeds tables (RLS blocks the anon key
# from reading subscribers or writing either table). Find it in Supabase →
# Project Settings → API → Project API keys → "service_role".
#
# ⚠️  This key BYPASSES row-level security — full read/write/delete on the whole
# database. It has NO NEXT_PUBLIC_ prefix on purpose, so Next.js never ships it
# to the browser. Keep it server-side only: never commit a real value and never
# reference it from a Client Component. The public site does not use it.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
